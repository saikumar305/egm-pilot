{
  "name": "egm-pilot",
  "version": "0.1.0",
  "description": "EGM Pilot: a task or an idea to a reviewed Draft merge request, built on the Elephant-Goldfish Model: deep-context drafting and building, zero-context Goldfish reviews, unattended or interactive.",
  "author": {
    "name": "Google LLC"
  },
  "homepage": "https://saikumar305.github.io/egm-pilot/",
  "repository": "https://github.com/saikumar305/egm-pilot",
  "license": "Apache-2.0",
  "agents": [
    "./.claude-plugin/agents/bootstrap_orchestrator.md",
    "./.claude-plugin/agents/code_bug_hunter.md",
    "./.claude-plugin/agents/code_quality.md",
    "./.claude-plugin/agents/code_security.md",
    "./.claude-plugin/agents/code_spec_auditor.md",
    "./.claude-plugin/agents/codebase_details.md",
    "./.claude-plugin/agents/comprehension.md",
    "./.claude-plugin/agents/design_critic.md",
    "./.claude-plugin/agents/implementation_readiness.md",
    "./.claude-plugin/agents/structural.md",
    "./.claude-plugin/agents/style.md",
    "./.claude-plugin/agents/synthesizer.md",
    "./.claude-plugin/agents/test_adequacy.md",
    "./.claude-plugin/agents/zoom_out.md"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/allow_plugin_reads.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/guard.sh\""
          }
        ]
      }
    ]
  }
}
